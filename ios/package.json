    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@revenuecat/purchases-capacitor": "^10.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
